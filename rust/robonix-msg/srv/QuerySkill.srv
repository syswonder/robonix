# QuerySkill service (EAIOS spec)
string name                    # Skill name
string filter                  # JSON: filter by metadata (e.g., {"domain":"indoor"}, {"robot":"arm6dof"})
---
SkillInstance[] instances

SkillInstance:
    string skill_id
    string provider
    string version
    string start_topic
    string status_topic
    string start_args
    string status
    string metadata
    string skill_dir
    string main_rtdl

