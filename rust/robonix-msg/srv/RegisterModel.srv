# RegisterModel service for registering AI models (LLM, VLM, etc.)
string model_id
string model_name
string model_type        # "LLM" or "VLM"
string provider          # e.g., "openai", "anthropic", "local"
string api_endpoint      # API endpoint URL
string api_key           # Optional API key (empty if not needed)
string description
string[] capabilities    # Supported capabilities
---
bool success
string error_message

