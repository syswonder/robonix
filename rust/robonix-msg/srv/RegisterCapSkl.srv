# RegisterCapSkl service for registering capabilities and skills
string package_name
string package_type
string std_name
string impl_id          # Implementation ID (e.g., "algo01", "algo02"). If empty, defaults to "default"
string description
string code_path
string[] input_names
string[] input_ros_types
string[] input_channels
string[] output_names
string[] output_ros_types
string[] output_channels
string[] config_services
string[] config_names
string hostname
string entity_name
---
bool success
string error_message