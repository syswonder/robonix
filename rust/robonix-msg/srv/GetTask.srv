# GetTask service for querying task information
string task_id           # Task ID
---
bool success
string error_message
string task_id
string natural_language
string dsl_code          # Generated DSL code (if available)
string state             # Task state: Pending, Generating, Parsing, Running, Completed, Failed, Cancelled
uint64 created_at        # Unix timestamp in nanoseconds
uint64 updated_at        # Unix timestamp in nanoseconds

