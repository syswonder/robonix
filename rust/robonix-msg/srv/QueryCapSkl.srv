# QueryCapSkl service for querying capability/skill information
string std_name          # Standard name (e.g., "cap::vision.capture_rgb")
string impl_id           # Implementation ID (optional). If empty, returns first match or all matches
string[] requirements    # Optional requirements/filters
---
bool success
string error_message
string impl_id           # Implementation ID of the returned capability/skill
string[] impl_ids        # All available implementation IDs for this std_name (if impl_id was empty)
string[] input_channels  # Input topic channels
string[] output_channels # Output topic channels
string[] input_names     # Input parameter names
string[] output_names    # Output parameter names
string[] input_types     # Input ROS message types
string[] output_types    # Output ROS message types

