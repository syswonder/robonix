# RTAB-Map + gRPC-to-ROS2 bridge for ManiSkill VLA demo.
# Receives RGB-D from env_node via gRPC, publishes as ROS2 topics,
# runs RTAB-Map for 3D mapping, logs results to Rerun on the host.
#
# Build context: rust/examples/packages/maniskill_vla_demo/
FROM introlab3it/rtabmap_ros:humble-latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    ros-humble-tf2-ros \
    ros-humble-sensor-msgs-py \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_BREAK_SYSTEM_PACKAGES=1
# Only lightweight runtime deps — no rerun.  SLAM results are served via
# the SlamDataService gRPC endpoint; the host-side viz_node logs them to Rerun.
RUN pip3 install --no-cache-dir \
    "grpcio>=1.60" \
    "protobuf>=4.25,<5" \
    "numpy<2"

# Bridge scripts
COPY docker/rtabmap_bridge.py  /app/rtabmap_bridge.py
COPY docker/rtabmap.launch.py  /app/rtabmap.launch.py
COPY docker/entrypoint.sh      /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Proto stubs for gRPC communication with robonix-atlas and env_node
COPY proto_stubs/robonix_runtime_pb2.py      /app/proto_stubs/
COPY proto_stubs/robonix_runtime_pb2_grpc.py /app/proto_stubs/
COPY maniskill_vla_demo/maniskill_env_pb2.py      /app/proto_stubs/
COPY maniskill_vla_demo/maniskill_env_pb2_grpc.py  /app/proto_stubs/

ENV PYTHONPATH=/app:/app/proto_stubs
WORKDIR /app

ENTRYPOINT ["/app/entrypoint.sh"]
