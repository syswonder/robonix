An End-2-end Robonix VLA + Vision Grouding + Visualization Demo

# download ReplicaCAD dataset
HF_ENDPOINT=https://hf-mirror.com \
huggingface-cli download \
  --repo-type dataset haosulab/ReplicaCAD \
  --local-dir ~/.maniskill/data/scene_datasets/replica_cad_dataset \
  --local-dir-use-symlinks False

# download Rearrange dataset
HF_ENDPOINT=https://hf-mirror.com \
huggingface-cli download \
  --repo-type dataset haosulab/ReplicaCADRearrange \
  --local-dir ~/.maniskill/data/scene_datasets/replica_cad_dataset/rearrange \
  --local-dir-use-symlinks False