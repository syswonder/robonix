namespace skill_demo/skill

import skill_demo_msgs/msg/GreetRequest
import skill_demo_msgs/msg/GreetFeedback
import skill_demo_msgs/msg/GreetResult

command greet
    @skill
    @desc("A Simple Skill to Greet a Person")
{
    input request GreetRequest
    output feedback GreetFeedback
    result response GreetResult
    version 1.0;
}
