#!/usr/bin/env bash
# Kill robonix-related processes and clean up shared memory
set -e

# robonix processes
pkill -9 -f 'robonix-server'   2>/dev/null || true
pkill -9 -f 'robonix-agent'    2>/dev/null || true
pkill -9 -f 'rbnx-daemon'      2>/dev/null || true

# example nodes (from rust/examples/nodes/)
pkill -9 -f 'sim_env\.py'      2>/dev/null || true
pkill -9 -f 'sim_viewer\.py'   2>/dev/null || true
pkill -9 -f 'vla_service\.py'  2>/dev/null || true
pkill -9 -f 'vlm_service\.py'  2>/dev/null || true
pkill -9 -f 'nl_to_vla\.py'    2>/dev/null || true

# nav2 stack
pkill -9 -f 'nav2'                         2>/dev/null || true
pkill -9 -f 'navigation2'                  2>/dev/null || true
pkill -9 -f 'lifecycle_manager_navigation' 2>/dev/null || true
pkill -9 -f 'bt_navigator'                 2>/dev/null || true
pkill -9 -f 'controller_server'            2>/dev/null || true
pkill -9 -f 'planner_server'               2>/dev/null || true
pkill -9 -f 'behavior_server'              2>/dev/null || true
pkill -9 -f 'waypoint_follower'            2>/dev/null || true
pkill -9 -f 'velocity_smoother'            2>/dev/null || true
pkill -9 -f 'smoother_server'              2>/dev/null || true

# rviz
pkill -9 -f 'rviz2' 2>/dev/null || true

# realsense
pkill -9 -f 'realsense2_camera' 2>/dev/null || true

# .robonix packages
pkill -9 -f '.robonix/packages/' 2>/dev/null || true

# fastrtps shared memory cleanup
rm -f /dev/shm/sem.fastrtps_* /dev/shm/fastrtps_* 2>/dev/null || true

echo "kill done."
