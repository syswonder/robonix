namespace robonix/system/model

import std_msgs/msg/String

query chat_completions
    @desc("OpenAI-compatible chat completions API. Use for LLM text generation.")
{
    request request_json String @desc("JSON: {model, messages: [{role, content}], temperature?, max_tokens?}");
    response response_json String @desc("JSON: {choices: [{message: {role, content}}], usage}");
    version 1.0;
}
