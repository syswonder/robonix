namespace robonix/system/model

import std_msgs/msg/String

query embeddings
    @desc("OpenAI-compatible embeddings API. Use for LLM/agent to get vector embeddings.")
{
    request request_json String @desc("JSON: {input: str|list[str], model, dimensions?}");
    response response_json String @desc("JSON: {data: [{embedding: float[], index}], usage}");
    version 1.0;
}
