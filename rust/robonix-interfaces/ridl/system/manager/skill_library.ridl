namespace robonix/system/manager

import std_msgs/msg/String
import robonix_msg/msg/SkillInstance

query skill_library
    @desc("List available skills; filter by capability or name. Use for LLM/agent to discover callable skills.")
{
    request filter String @desc("JSON filter, e.g. {\"capability\":\"greet\"} or empty for all");
    response skills SkillInstance[] @desc("Skill instances with id, input_schema, output_schema");
    version 1.0;
}
