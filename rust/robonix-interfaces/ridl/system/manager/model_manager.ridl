namespace robonix/system/manager

import std_msgs/msg/String
import robonix_msg/msg/ServiceInstance

query model_manager
    @desc("List available LLM/model services. Use for LLM/agent to discover chat, embeddings, vision APIs.")
{
    request filter String @desc("JSON filter or empty for all");
    response models ServiceInstance[] @desc("Model instances with endpoint, capabilities");
    version 1.0;
}
