namespace robonix/prm/arm

import sensor_msgs/msg/JointState
import std_msgs/msg/Bool

command move_joint
    @desc("Move arm to joint positions. Use for LLM/agent to set joint angles.")
{
    input joint_positions JointState @desc("Target positions per joint");
    result status Bool @desc("True if reached positions");
    version 1.0;
}
