namespace robonix/prm/arm

import geometry_msgs/msg/PoseStamped
import std_msgs/msg/Bool

command move_ee
    @desc("Move end-effector to pose. Use for LLM/agent to reach target position.")
{
    input pose PoseStamped @desc("Target pose in frame_id");
    result status Bool @desc("True if reached pose");
    version 1.0;
}
