# Minimal image to run rmw_zenohd (Zenoh router for rmw_zenoh_cpp).
# Use humble-desktop (ros-base tag not always available on Docker Hub).
FROM osrf/ros:humble-desktop

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rmw-zenoh-cpp \
    && rm -rf /var/lib/apt/lists/*

# Default: listen for ROS 2 nodes using rmw_zenoh_cpp.
CMD ["ros2", "run", "rmw_zenoh_cpp", "rmw_zenohd"]
