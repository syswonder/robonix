#!/usr/bin/env bash
set -euo pipefail

MANIFEST_PATH="${1:?manifest path required}"
BIN_NAME="${2:?binary name required}"
ROS_DISTRO_NAME="${ROS_DISTRO:-humble}"
CRATE_DIR="$(cd "$(dirname "$MANIFEST_PATH")" && pwd)"
INTERFACES_WS="$CRATE_DIR/target/rclrs_interfaces_ws"

if [[ -f "/opt/ros/$ROS_DISTRO_NAME/setup.bash" ]]; then
  set +u
  source "/opt/ros/$ROS_DISTRO_NAME/setup.bash"
  set -u
fi

export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_zenoh_cpp}"

# Avoid setuptools/packaging mismatch (canonicalize_version strip_trailing_zero)
# Upgrade both so colcon's Python uses a consistent setuptools; do not use PYTHONNOUSERSITE below so ~/.local is visible.
pip3 install --user --upgrade 'packaging>=22.0' 'setuptools>=72' 2>/dev/null || true

cargo check --quiet --manifest-path "$MANIFEST_PATH" --bin "$BIN_NAME"

if [[ -d "$INTERFACES_WS/src/generated/robonix_interfaces_ros2" ]]; then
  colcon build \
    --base-paths "$INTERFACES_WS/src" \
    --build-base "$INTERFACES_WS/build" \
    --install-base "$INTERFACES_WS/install" \
    --merge-install \
    --packages-up-to robonix_interfaces_ros2
fi

if [[ -f "$INTERFACES_WS/install/setup.bash" ]]; then
  set +u
  source "$INTERFACES_WS/install/setup.bash"
  set -u
fi
