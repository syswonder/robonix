#!/bin/bash
# rbnx_stop script for demo_provider
# This script is called by robonix to stop the capability

set -e

PID_FILE="/tmp/demo_rgb_provider.pid"

if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    
    if ps -p $PID > /dev/null 2>&1; then
        echo "Stopping demo RGB camera provider (PID: $PID)..."
        kill $PID
        wait $PID 2>/dev/null || true
        echo "Demo RGB camera provider stopped."
    else
        echo "Process with PID $PID is not running."
    fi
    
    rm -f "$PID_FILE"
else
    echo "PID file not found. Trying to kill by process name..."
    pkill -f "rgb_publisher" || echo "No running rgb_publisher process found."
fi

