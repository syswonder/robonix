#!/bin/bash
# rbnx_start script for demo_provider
# This script is called by robonix to start the capability

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Source ROS2 setup if available
if [ -f /opt/ros/humble/setup.bash ]; then
    source /opt/ros/humble/setup.bash
fi

# Fix library path issues with conda environment
# Prefer system libraries over conda libraries for ROS2
if [ -n "$CONDA_PREFIX" ]; then
    export LD_LIBRARY_PATH="/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}"
    # Remove conda libstdc++ from path
    export LD_LIBRARY_PATH=$(echo "$LD_LIBRARY_PATH" | tr ':' '\n' | grep -v "$CONDA_PREFIX/lib" | tr '\n' ':' | sed 's/:$//')
fi

# Build the package if not already built
if [ ! -d "install" ]; then
    echo "Building demo_rgb_provider package..."
    colcon build --packages-select demo_rgb_provider
fi

# Source the local setup (use setup.sh as fallback if setup.bash doesn't exist)
if [ -f "install/setup.bash" ]; then
    source install/setup.bash
elif [ -f "install/setup.sh" ]; then
    source install/setup.sh
fi

# Start the RGB publisher node in background
echo "Starting demo RGB camera provider..."
# Use system Python to avoid conda library conflicts
SYSTEM_PYTHON="/usr/bin/python3"
if [ -f "$SYSTEM_PYTHON" ]; then
    # Add install directory to PYTHONPATH
    export PYTHONPATH="$SCRIPT_DIR/install/demo_rgb_provider/lib/python3.10/site-packages:${PYTHONPATH}"
    # Use system Python with proper library path
    LD_LIBRARY_PATH="/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH" \
    $SYSTEM_PYTHON -m demo_rgb_provider.rgb_publisher > /tmp/demo_rgb_provider.log 2>&1 &
elif command -v ros2 > /dev/null 2>&1; then
    ros2 run demo_rgb_provider rgb_publisher > /tmp/demo_rgb_provider.log 2>&1 &
else
    # Fallback: run Python script directly
    python3 -m demo_rgb_provider.rgb_publisher > /tmp/demo_rgb_provider.log 2>&1 &
fi
PID=$!

# Save PID to file for rbnx_stop to use
echo $PID > /tmp/demo_rgb_provider.pid

# Wait a moment to check if the process started successfully
sleep 2
if ps -p $PID > /dev/null 2>&1; then
    echo "Demo RGB camera provider started successfully with PID: $PID"
    echo "Logs available at: /tmp/demo_rgb_provider.log"
else
    echo "Error: Failed to start demo RGB camera provider. Check logs at /tmp/demo_rgb_provider.log"
    if [ -f /tmp/demo_rgb_provider.log ]; then
        echo "Last 20 lines of log:"
        tail -20 /tmp/demo_rgb_provider.log
    fi
    rm -f /tmp/demo_rgb_provider.pid
    exit 1
fi

