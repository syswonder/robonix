#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LISTEN_ADDR="${ROBONIX_META_GRPC_ADDR:-0.0.0.0:50051}"
ADVERTISED_ENDPOINT="${ROBONIX_META_GRPC_ENDPOINT:-127.0.0.1:50051}"

export ROBONIX_META_GRPC_ADDR="$LISTEN_ADDR"
export ROBONIX_META_GRPC_ENDPOINT="$ADVERTISED_ENDPOINT"
export RUST_LOG="${RUST_LOG:-robonix_atlas=info}"

LISTEN_PORT="${LISTEN_ADDR##*:}"

# Kill any existing process on the listen port
python3 - "$LISTEN_PORT" <<'PY'
import os, signal, sys, time

port = int(sys.argv[1])
hex_port = format(port, "04X")
inodes = set()
for path in ("/proc/net/tcp", "/proc/net/tcp6"):
    try:
        with open(path) as f:
            next(f)
            for line in f:
                parts = line.split()
                local, state, inode = parts[1], parts[3], parts[9]
                if local.split(":")[1].upper() == hex_port and state == "0A":
                    inodes.add(inode)
    except FileNotFoundError:
        pass

pids = []
for pid in os.listdir("/proc"):
    if not pid.isdigit():
        continue
    fd_dir = f"/proc/{pid}/fd"
    try:
        for fd in os.listdir(fd_dir):
            try:
                target = os.readlink(os.path.join(fd_dir, fd))
            except OSError:
                continue
            if target.startswith("socket:[") and target[8:-1] in inodes:
                pids.append(int(pid))
                break
    except OSError:
        continue

pids = sorted(set(pids))
if not pids:
    raise SystemExit(0)

for pid in pids:
    print(f"[start_server] killing process {pid} on port {port}", flush=True)
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        continue

deadline = time.time() + 5.0
while time.time() < deadline:
    remaining = []
    for pid in pids:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            continue
        remaining.append(pid)
    if not remaining:
        raise SystemExit(0)
    time.sleep(0.1)

for pid in remaining:
    print(f"[start_server] force killing process {pid}", flush=True)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
PY

exec cargo run -p robonix-atlas
