# RegisterSkill service (robonix spec)
string name                    # Skill name
string type                    # Skill type: "basic" | "rtdl"
string start_topic             # Skill start topic
string status_topic            # Status feedback topic
string entry                   # Basic skill entry (required if type="basic")
string skill_dir               # Skill directory path (required if type="rtdl")
string main_rtdl               # Main RTDL file name (required if type="rtdl")
string start_args              # JSON: input parameter schema
string status                  # JSON: status feedback schema
string metadata                # JSON: metadata for instance filtering
string provider                # Skill provider identifier
string version                 # Skill version
---
bool ok
string skill_id

