#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUST_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST_PATH="$RUST_DIR/robonix-server/Cargo.toml"

set +u
source "$RUST_DIR/setup_zenoh_rclrs_env" "$MANIFEST_PATH" callquery
set -u

exec cargo run --quiet --manifest-path "$MANIFEST_PATH" --bin callquery -- "$@"
