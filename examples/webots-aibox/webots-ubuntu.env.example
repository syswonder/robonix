# Board-side Zenoh/Atlas wiring for the split deployment. Copy to
# /root/robonix/run/webots-ubuntu.env and replace the placeholder addresses:
# 192.0.2.10 = the Ubuntu sim host, 192.0.2.20 = the AIBOX board
# (the same placeholders remote.env.example uses). boot.env sources this file.

# Board-local components reach Atlas on loopback; docker containers on the
# board reach it through the docker bridge gateway. ROBONIX_ADVERTISE_HOST
# gives board-local containers an address to advertise to board consumers
# (the sim-host drivers get theirs from remote.env:SIM_HOST_IP instead).
export ROBONIX_ATLAS=127.0.0.1:50051
export ROBONIX_SIM_ATLAS=172.17.0.1:50051
export ROBONIX_ADVERTISE_HOST=172.17.0.1

# The board's ROS 2 is a pure Zenoh client of the router inside the sim
# container on the Ubuntu host.
export ROBONIX_SIM_HOST_IP=192.0.2.10
export ROBONIX_ZENOH_ROUTER=tcp/${ROBONIX_SIM_HOST_IP}:7447
export ROBONIX_ZENOH_MODE=client
export RMW_IMPLEMENTATION=rmw_zenoh_cpp
export ZENOH_SESSION_CONFIG_URI=/root/robonix/run/zenoh-aibox.json5
export ZENOH_ROUTER_CHECK_ATTEMPTS=20

# Uncomment only while the VLM endpoint is reachable through an SSH reverse
# tunnel (see the deploy-aibox-ubuntu runbook); delete when AIBOX reaches it
# directly.
# export HTTPS_PROXY=http://127.0.0.1:18080
# export HTTP_PROXY=http://127.0.0.1:18080
# export NO_PROXY=localhost,127.0.0.1,172.17.0.1,192.0.2.20,${ROBONIX_SIM_HOST_IP}
# export no_proxy=${NO_PROXY}
