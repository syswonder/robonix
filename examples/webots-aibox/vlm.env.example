# VLM credentials for pilot. The deploy manifest's ${VLM_*} references
# expand these names; pilot fails fast when any is missing. Copy to
# /root/robonix/run/vlm.env and fill in — the real file stays local-only.
export VLM_BASE_URL=http://<vlm-host>:<port>/v1
export VLM_API_KEY=<api-key>
export VLM_MODEL=<model-name>
