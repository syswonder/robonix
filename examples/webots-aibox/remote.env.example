# Cross-machine facts for the SSH-wrapped TIAGo primitives.
# Sourced by scripts/{remote_build,start,stop}.sh. Copy this file to
# remote.env and fill in your machines' values;

# Board -> sim host SSH alias (board's ~/.ssh/config). Must work with
# BatchMode=yes, i.e. pubkey auth only.
HOST_SSH=aibox-ubuntu

# Robonix checkout on the sim host; its examples/webots tree is bind-mounted
# into the sim container, so the primitive codegen must run there.
HOST_WEBOTS_ROOT=/home/<user>/robonix

# An IP of the sim host reachable from the board. Drivers on the sim host
# advertise their lifecycle endpoints on it so the board can reach them.
SIM_HOST_IP=192.0.2.10

# The board's address. Drivers on the sim host register with Atlas over
# this endpoint — the board-local 127.0.0.1:50051 is unreachable from there.
BOARD_ATLAS=192.0.2.20:50051
