# All generated artefacts (codegen output, model weights, runtime data)
# live under rbnx-build/.
rbnx-build/

# Legacy default codegen output paths (kept ignored so older trees don't
# leak generated stuff into git after a `rbnx codegen` run that doesn't
# pass --out-dir).
proto_gen/
robonix_mcp_types/

# Pre-fetched model weights (yolov8l-world.pt etc.) live under docker/
# during build to keep the docker COPY cache-stable; not committed.
docker/_weights/

# Container-side editable install cache that scene's build.sh uses.
.uv-cache/

# The rerun web viewer, vendored at build time. 48 MB of wasm does not belong
# in the history; scripts/fetch_viewer.sh puts it back.
scene_service/web_assets/rerun/

# Which image `scripts/dev-up.sh` boots, pinned by ID. Machine-local: the ID
# names an image in one host's docker, and pinning is the point -- a shared
# tag is what kept getting stolen. Recreate with `scripts/dev-up.sh --pin`.
scripts/dev-image.pin
