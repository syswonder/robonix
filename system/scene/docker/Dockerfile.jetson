# SPDX-License-Identifier: MulanPSL-2.0
# Complete Jetson Scene application; GPU userspace is supplied by the image.
ARG ROS_BASE_IMAGE=nvcr.io/nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04@sha256:e5ad51a95a1438e7dcba242b70dfd207684fa4c73b7618f865df27b9eb92f57d
FROM ${ROS_BASE_IMAGE} AS dependencies

ARG ROS_DISTRO=jazzy
ARG CUDA_APT_SUFFIX=12-9
ENV ROS_DISTRO=${ROS_DISTRO} \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive
# Bootstrap ROS's signed apt repository, independent of host ROS packages.
COPY _build/ros-source.deb /tmp/ros-source.deb
RUN dpkg -i /tmp/ros-source.deb && rm /tmp/ros-source.deb
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3-venv python3-pip python3-numpy libgl1 libglib2.0-0 libgomp1 libopenblas0 cuda-cupti-${CUDA_APT_SUFFIX} build-essential cmake \
        ros-${ROS_DISTRO}-ros-base ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-rmw-zenoh-cpp python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/scene-venv
ENV PATH=/opt/scene-venv/bin:${PATH} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

COPY requirements/scene-base.txt requirements/scene-perception-native.txt \
     requirements/scene-perception-lock.txt requirements/scene-perception-export.txt \
     requirements/scene-perception-engines.txt /tmp/requirements/
COPY _build/gpu-wheels.txt /tmp/gpu-wheels.txt
COPY _build/gpu-constraints.txt /tmp/gpu-constraints.txt
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --no-deps -r /tmp/gpu-wheels.txt \
    && pip install -c /tmp/gpu-constraints.txt -c /tmp/requirements/scene-perception-lock.txt \
        -r /tmp/requirements/scene-base.txt -r /tmp/requirements/scene-perception-native.txt
# Open3D loads EGL even when Scene only uses point-cloud operations.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends libegl1 \
    && rm -rf /var/lib/apt/lists/*
COPY _build/tensorrt-packages.txt _build/tensorrt-key.asc _build/tensorrt-source.list /tmp/
ARG SCENE_CG_INFERENCE=torch
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    set -e; \
    if [ "$SCENE_CG_INFERENCE" = tensorrt ]; then \
        pip install -c /tmp/gpu-constraints.txt -c /tmp/requirements/scene-perception-lock.txt \
            -r /tmp/requirements/scene-perception-export.txt \
            -r /tmp/requirements/scene-perception-engines.txt; \
        if [ -s /tmp/tensorrt-packages.txt ]; then \
            cp /tmp/tensorrt-key.asc /usr/share/keyrings/scene-jetson.asc; \
            cp /tmp/tensorrt-source.list /etc/apt/sources.list.d/scene-jetson.list; \
            apt-get update; \
            xargs -r apt-get install -y --no-install-recommends < /tmp/tensorrt-packages.txt; \
            rm -rf /var/lib/apt/lists/*; \
        fi; \
    fi

ENV SCENE_CG_INFERENCE=${SCENE_CG_INFERENCE} \
    SCENE_YOLO_WORLD_WEIGHTS=/opt/models/yolov8l-world.pt \
    SCENE_MOBILE_SAM_WEIGHTS=/opt/models/mobile_sam.pt \
    SCENE_CLIP_MODEL=ViT-B-32 \
    SCENE_CLIP_PRETRAINED=/opt/models/open_clip_pytorch_model.bin \
    YOLO_CONFIG_DIR=/opt/ultralytics \
    PYTHONPATH=/scene:/robonix-api:/scene/rbnx-build/codegen/scene_proto_gen:/scene/rbnx-build/codegen/robonix_mcp_types
# Keep the viewer's NumPy-compatible Arrow pin after the GPU dependency layers.
COPY requirements/scene-viewer.txt /tmp/requirements/scene-viewer.txt
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-deps -r /tmp/requirements/scene-viewer.txt \
    && v="$(sed -n 's/^rerun-sdk==//p' /tmp/requirements/scene-viewer.txt)" \
    && mkdir -p /opt/rerun-web-viewer \
    && curl -fSL --retry 3 --connect-timeout 20 \
        "${NPM_REGISTRY}/@rerun-io/web-viewer/-/web-viewer-${v}.tgz" -o /tmp/scene-viewer.tgz \
    && tar xzf /tmp/scene-viewer.tgz -C /opt/rerun-web-viewer --strip-components=1 \
        package/index.js package/re_viewer.js package/re_viewer_bg.wasm \
    && rm /tmp/scene-viewer.tgz
FROM dependencies AS application
COPY _build/models/yolov8l-world.pt _build/models/mobile_sam.pt _build/models/open_clip_pytorch_model.bin /opt/models/
COPY _build/models/ViT-B-32.pt /opt/models/ultralytics/clip/ViT-B-32.pt
COPY _build/api /robonix-api
COPY _build/scene /scene
COPY entrypoint.sh /scene/docker/entrypoint.sh
COPY _build/container-policy.json /scene/container-policy.json
WORKDIR /scene
RUN python -m grpc_tools.protoc \
        -I/scene/rbnx-build/runtime-proto -I/scene/rbnx-build/proto-staging \
        --python_out=/scene/rbnx-build/codegen/scene_proto_gen \
        --grpc_python_out=/scene/rbnx-build/codegen/scene_proto_gen \
        /scene/rbnx-build/runtime-proto/*.proto /scene/rbnx-build/proto-staging/*.proto \
    && ln -s scene_proto_gen /scene/rbnx-build/codegen/proto_gen \
    && python -c 'import importlib,pathlib; p=pathlib.Path("rbnx-build/codegen/scene_proto_gen"); [importlib.import_module(f.stem) for f in p.glob("*_pb2*.py")]'
RUN mkdir -p /opt/ultralytics
RUN python - <<'PY'
from ultralytics.utils import SETTINGS
SETTINGS.update({'weights_dir': '/opt/models/ultralytics', 'sync': False})
PY
RUN bash -c 'source /opt/ros/${ROS_DISTRO}/setup.bash && python scripts/check_docker.py --inference "$SCENE_CG_INFERENCE" --imports-only'
RUN bash -c 'source /opt/ros/${ROS_DISTRO}/setup.bash && cd /scene/rbnx-build/codegen/ros2_idl && colcon build --packages-up-to map' \
    && pip freeze > /scene/container-requirements.txt \
    && dpkg-query -W -f='${Package}=${Version}\n' >> /scene/container-requirements.txt
ENTRYPOINT ["/bin/bash", "/scene/docker/entrypoint.sh"]

ARG SCENE_SOURCE_SHA
ARG SCENE_BASE_PIN
ARG SCENE_L4T_PREFIX
LABEL io.robonix.scene.packaged="1" \
      io.robonix.scene.base=${SCENE_BASE_PIN} \
      io.robonix.scene.source=${SCENE_SOURCE_SHA} \
      io.robonix.scene.l4t=${SCENE_L4T_PREFIX} \
      io.robonix.scene.inference=${SCENE_CG_INFERENCE}
