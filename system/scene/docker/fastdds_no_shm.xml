<?xml version="1.0" encoding="UTF-8"?>
<!--
  Disables FastRTPS shared-memory transport for the scene container.
  Reason: the webots sim container runs with default `ipc:private` on
  Docker Compose; scene is in a separate container with its own
  /dev/shm. SHM transport can't see across the namespace, so without
  this profile FastRTPS prefers SHM, advertises both, and DDS endpoint
  matching silently drops cross-container traffic.

  With useBuiltinTransports=false + only `udp4`, scene uses pure UDP4
  on the host loopback (we're --network host), which the sim side
  can also speak. ~1 ms latency penalty at most for camera frames;
  worth it for the cross-container interop.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_transport</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="participant_no_shm" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_transport</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
