# RViz2 config for the 2026-05-25 demo: nav2 + mapping + fastlio + ranger.
#
# Drop this file at  ~/robonix-v0.1-deploy/  on the car and launch with:
#   rviz2 -d ~/robonix-v0.1-deploy/demo_nav.rviz
#
# Fixed Frame defaults to `map` (nav2 convention). If you haven't loaded a
# saved map and are only running fastlio, switch Fixed Frame to
# `fastlio_world` in the top-left Global Options.
#
# Toolbar (left-right):
#   2D Pose Estimate → /initialpose   (seed AMCL / a SLAM anchor)
#   Nav2 Goal        → /goal_pose     (nav2 BT navigator subscribes)
#   Publish Point    → /clicked_point (debug markers)
Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /Nav2 Global Plan1
        - /Nav2 Global Costmap1
        - /Nav2 Local Costmap1
        - /Robot Footprint1
        - /LIO Odom1
        - /Chassis Odom1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    # ── basics ──
    - Alpha: 0.5
      Cell Size: 1.0
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style: { Line Width: 0.03, Value: Lines }
      Name: Grid
      Normal Cell Count: 0
      Offset: { X: 0, Y: 0, Z: 0 }
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames: { All Enabled: true }
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: true

    # ── nav2 layer (the demo focus) ──
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Nav2 Map (loaded)
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Nav2 Global Costmap
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Nav2 Local Costmap
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 30; 200; 255
      Enabled: true
      Head Diameter: 0.0
      Head Length: 0.0
      Length: 0.3
      Line Style: Lines
      Line Width: 0.05
      Name: Nav2 Global Plan
      Offset: { X: 0, Y: 0, Z: 0 }
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.0
      Shaft Length: 0.0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 200; 30
      Enabled: true
      Head Diameter: 0.0
      Head Length: 0.0
      Length: 0.3
      Line Style: Lines
      Line Width: 0.04
      Name: Nav2 Local Plan
      Offset: { X: 0, Y: 0, Z: 0 }
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.0
      Shaft Length: 0.0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_plan
      Value: true
    - Alpha: 1.0
      Class: rviz_default_plugins/Polygon
      Color: 0; 255; 100
      Enabled: true
      Name: Robot Footprint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Value: true

    # ── localisation + odometry layer ──
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation: { Alpha: 0.5, Color: 255; 255; 127, Color Style: Unique, Frame: Local, Offset: 1.0, Scale: 1.0, Value: false }
        Position: { Alpha: 0.3, Color: 204; 51; 204, Scale: 1.0, Value: false }
        Value: false
      Enabled: true
      Keep: 200
      Name: LIO Odom
      Position Tolerance: 0.05
      Shape:
        Alpha: 1.0
        Axes Length: 0.3
        Axes Radius: 0.04
        Color: 0; 220; 0
        Head Length: 0.15
        Head Radius: 0.06
        Shaft Length: 0.4
        Shaft Radius: 0.02
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lio_odom
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 127
      Enabled: true
      Head Diameter: 0.0
      Head Length: 0.0
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: LIO Path
      Offset: { X: 0, Y: 0, Z: 0 }
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.0
      Shaft Length: 0.0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lio_path
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation: { Alpha: 0.5, Color: 255; 255; 127, Color Style: Unique, Frame: Local, Offset: 1.0, Scale: 1.0, Value: false }
        Position: { Alpha: 0.3, Color: 204; 51; 204, Scale: 1.0, Value: false }
        Value: false
      Enabled: true
      Keep: 200
      Name: Chassis Odom
      Position Tolerance: 0.05
      Shape:
        Alpha: 1.0
        Axes Length: 0.3
        Axes Radius: 0.04
        Color: 200; 80; 0
        Head Length: 0.15
        Head Radius: 0.06
        Shaft Length: 0.4
        Shaft Radius: 0.02
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Value: true

    # ── sensor layer ──
    - Alpha: 0.7
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: { Max Value: 5.0, Min Value: -2.0, Value: true }
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: LIO World Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /world_cloud
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: { Max Value: 5.0, Min Value: -2.0, Value: true }
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 200; 0
      Color Transformer: FlatColor
      Decay Time: 0.1
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Live Lidar Scan
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scanner/cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # ── camera (off by default; toggle on for visual confirmation) ──
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RealSense RGB
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Value: false
  Enabled: true
  Global Options:
    Background Color: 30; 30; 35
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current: { Class: rviz_default_plugins/TF }
  Value: true
  Views:
    # Top-down ortho — better for navigation than orbit. Roll wheel to zoom.
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1.0
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: TopDown
      Near Clip Distance: 0.01
      Scale: 32
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 18
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1.0
          Swap Stereo Eyes: false
          Value: false
        Focal Point: { X: 0, Y: 0, Z: 0 }
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Orbit (3D)
        Near Clip Distance: 0.01
        Pitch: 0.6
        Target Frame: <Fixed Frame>
        Value: Orbit (rviz_default_plugins)
        Yaw: 0.785
Window Geometry:
  Displays: { collapsed: false }
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Selection: { collapsed: false }
  Time: { collapsed: false }
  Tool Properties: { collapsed: false }
  Views: { collapsed: false }
  Width: 1600
  X: 80
  Y: 60
