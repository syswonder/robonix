// ──────────────────────────────────────────────────────────────────────────
// Speech Service — gRPC service definitions for ASR / TTS / Dialog
//
// Architecture position: robonix/service/speech (service layer)
//   - Receives audio from lower-layer primitive drivers (e.g. audio_driver)
//   - Auto-adapts any input sample_rate / channels / encoding to 16kHz mono s16le
//   - Outputs 16 kHz mono pcm_s16le audio for downstream playback
//
// Self-contained: all message types are inlined (no external proto imports).
// Build: scripts/build.sh generates *_pb2.py / *_pb2_grpc.py into proto_gen/
// ──────────────────────────────────────────────────────────────────────────

syntax = "proto3";
package robonix.speech_service;

// ── Shared types ─────────────────────────────────────────────────────────
// Inlined here so the package builds without cross-package proto dependencies.
// These mirror the types in audio_driver.proto but are intentionally decoupled.

// Describes an audio stream's format. Used by both ASR (to describe input)
// and TTS (to describe output).
message AudioConfig {
  string encoding = 1;       // e.g. "pcm_s16le", "pcm_f32le", "mp3", "wav"
  uint32 sample_rate_hz = 2; // e.g. 16000, 24000, 44100, 48000
  uint32 channels = 3;       // 1 = mono, 2 = stereo
  uint32 bits_per_sample = 4; // 8, 16, 24, or 32
}

// A single time-stamped audio chunk, used in streaming RPCs.
message AudioChunk {
  uint64 timestamp_ns = 1;   // nanoseconds since epoch (clock_gettime)
  bytes data = 2;            // raw PCM bytes (length = samples × channels × bytes_per_sample)
  uint32 sequence = 3;       // monotonically increasing counter per stream
  float duration_s = 4;      // chunk duration in seconds (e.g. 0.1 for 100ms)
}

// ── ASR (Automatic Speech Recognition) ───────────────────────────────────

// One-shot recognition: send complete audio, receive transcription.
// The service adapts any sample_rate / channels / encoding to 16kHz mono s16le
// internally, so the caller does not need to pre-process audio.
message RecognizeRequest {
  bytes audio_data = 1;      // complete audio (PCM or WAV)
  string encoding = 2;       // audio encoding, default "pcm_s16le"
  uint32 sample_rate_hz = 3; // input sample rate, default 16000
  string language = 4;       // BCP-47 tag, e.g. "zh", "en", "ja"
  uint32 channels = 5;       // number of channels, default 1 (proto3 field addition, backward compatible)
  uint32 bits_per_sample = 6; // bits per sample, default 16 (proto3 field addition, backward compatible)
}

message RecognizeResponse {
  string text = 1;           // transcribed text (UTF-8)
  float confidence = 2;      // 0.0 – 1.0, estimated confidence
  string error = 3;          // non-empty on failure
}

// Streaming recognition: client sends audio chunk-by-chunk, server yields
// partial and final transcriptions in real time.
//
// Protocol:
//   1. First message SHOULD set audio_config + language
//   2. Subsequent messages carry chunk.data
//   3. Client closes stream to signal end-of-utterance
//   4. Server sends final result with is_final=true
message RecognizeStreamRequest {
  AudioConfig audio_config = 1; // sent in first message (or when config changes)
  string language = 2;          // BCP-47 tag
  AudioChunk chunk = 3;         // audio chunk data
}

message RecognizeStreamResponse {
  uint32 event_type = 1;   // 0 = PARTIAL (intermediate), 1 = FINAL, 2 = ERROR
  string text = 2;         // transcribed text so far
  float confidence = 3;    // 0.0 – 1.0
  string language = 4;     // detected or requested language
  bool is_final = 5;       // true on last response before stream closes
  string error = 6;        // non-empty when event_type = 2
}

// ASR service: two recognition modes.
service SpeechAsr {
  // Unary: send complete audio buffer, get one transcription.
  // Backend: Whisper (transformers pipeline, GPU FP16).
  rpc Recognize (RecognizeRequest) returns (RecognizeResponse);

  // Bidirectional streaming: chunk-by-chunk audio → partial/final results.
  // Backend: FunASR Paraformer-zh-streaming (600ms granularity, 300ms lookahead).
  rpc RecognizeStream (stream RecognizeStreamRequest) returns (stream RecognizeStreamResponse);
}

// ── TTS (Text-to-Speech) ────────────────────────────────────────────────

// One-shot synthesis: send text, receive complete audio.
message SynthesizeRequest {
  string text = 1;           // text to synthesize (UTF-8)
  string language = 2;       // BCP-47 tag for pronunciation hints
  string voice = 3;          // voice name, e.g. "zh-CN-XiaoxiaoNeural"
  float speed = 4;           // speech speed multiplier (1.0 = normal)
}

message SynthesizeResponse {
  bytes audio_data = 1;      // synthesized 16-bit PCM audio
  string encoding = 2;       // "pcm_s16le"
  uint32 sample_rate_hz = 3; // 16000
  string error = 4;          // non-empty on failure
}

// Streaming synthesis: send text, receive audio in chunks.
// Useful for long text — playback can begin before synthesis completes.
message SynthesizeStreamRequest {
  string text = 1;
  string language = 2;
  string voice = 3;
  float speed = 4;
}

message SynthesizeStreamResponse {
  bytes audio_data = 1;      // one 16-bit PCM audio chunk
  string encoding = 2;       // "pcm_s16le"
  uint32 sample_rate_hz = 3; // 16000
  bool is_final = 4;         // true on last chunk (audio_data empty)
}

// TTS service: two synthesis modes.
service SpeechTts {
  // Unary: send text, get complete PCM audio.
  // Backend: configured local or cloud TTS implementation.
  rpc Synthesize (SynthesizeRequest) returns (SynthesizeResponse);

  // Server streaming: send text, receive PCM chunks as they're generated.
  rpc SynthesizeStream (SynthesizeStreamRequest) returns (stream SynthesizeStreamResponse);
}

// ── Dialog (voice interaction session) ───────────────────────────────────

// Start a managed voice dialog session. The server maintains session state
// (IDLE → LISTENING → PROCESSING → SPEAKING → IDLE) and streams state
// updates back to the client. Intended for future VAD + turn-taking logic.
message StartDialogRequest {
  string language = 1;  // BCP-47 tag, default "zh-CN"
  bool enable_vad = 2;  // enable voice activity detection (reserved for future use)
}

message StartDialogResponse {
  string session_id = 1;    // unique session identifier (UUID prefix)
  uint32 state = 2;         // session state: 0=IDLE, 1=LISTENING, 2=PROCESSING, 3=SPEAKING, 4=ERROR
  string error = 3;         // non-empty on error
}

service SpeechDialog {
  // Server streaming: opens a dialog session, streams state transitions.
  // Session is automatically cleaned up when the client disconnects.
  rpc StartDialog (StartDialogRequest) returns (stream StartDialogResponse);
}
