# All generated artefacts (uv venv, codegen output, runtime data, model cache)
# live under rbnx-build/ at runtime. The proto stub directory `_generated/`
# inside voiceprint_service/ is bootstrapped on first import; never commit it.
rbnx-build/
voiceprint_service/_generated/
pretrained_models/
__pycache__/
*.pyc
*.pyo
*.pt
*.ckpt
*.log
