# robonix/service/navigation/set_speed — dynamically change the speed limit
# used by a running navigation service. The limit is a percentage of the
# deployment-owned controller maximum; providers must never exceed that
# configured maximum.
#
# operation:
#   "faster" — increase the current percentage by the provider's configured step
#   "slower" — decrease the current percentage by the configured step
#   "set"    — use percentage directly
#   "reset"  — restore the provider's configured default
string operation
float64 percentage
---
bool ok
bool changed
float64 effective_percentage
string detail
